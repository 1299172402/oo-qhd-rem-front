{
  "name": "intelligent-oilfield",
  "version": "1.1.22",
  "private": false,
  "scripts": {
    "prepare": "husky install",
    "dev:mock": "vite --open --mode mock",
    "dev": "vite --open --mode development",
    "dev:linux": "vite --mode development",
    "build:test": "vite build --mode test",
    "build": "vite build --mode release",
    "site:preview": "npm run build && cp -r dist _site",
    "preview": "vite preview",
    "stylelint": "stylelint src/**/*.{html,vue,sass,less}",
    "stylelint:fix": "stylelint --cache --fix src/**/*.{html,vue,vss,sass,less}",
    "test": "echo \"no test specified,work in process\"",
    "test:coverage": "echo \"no test:coverage specified,work in process\"",
    "lint": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0",
    "lint:fix": "eslint --ext .vue,.js,jsx,.ts,.tsx ./ --max-warnings 0 --fix",
    "css": "stylelint --config .stylelintrc.js src/**/*.{html,vue,sass,less}",
    "css:fix": "stylelint --config .stylelintrc.js src/**/*.{html,vue,sass,less} --fix"
  },
  "dependencies": {
    "@riophae/vue-treeselect": "0.4.0",
    "axios": "^1.1.3",
    "dayjs": "^1.10.8",
    "echarts": "~5.1.2",
    "element-ui": "^2.15.10",
    "file-saver": "2.0.5",
    "highlight.js": "9.18.5",
    "html2canvas": "1.4.1",
    "js-cookie": "^3.0.1",
    "jsencrypt": "3.2.1",
    "lodash": "^4.17.21",
    "mxgraph": "^4.2.2",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "qrcode.vue": "^1.7.0",
    "tdesign-icons-vue": "^0.1.0",
    "tdesign-vue": "^0.49.0",
    "tvision-color": "~1.4.0",
    "typescript": "^4.2.4",
    "vue": "~2.6.14",
    "vue-clipboard2": "^0.3.1",
    "vue-grid-layout": "^2.4.0",
    "vue-router": "^3.5.1",
    "vuex": "^3.6.2",
    "vuex-router-sync": "^5.0.0",
    "vue-cropper": "0.5.5",
    "vxe-table": "3.6.9",
    "xe-utils": "3.5.7",
    "uuid": "^9.0.0",
    "sm4js": "^0.0.6",
    "d3": "^7.8.4",
    "echarts-liquidfill": "^3.1.0",
    "vue-giant-tree": "^0.1.5"
  },
  "devDependencies": {
    "@types/vue-color": "^2.4.3",
    "@typescript-eslint/eslint-plugin": "^4.19.0",
    "@typescript-eslint/parser": "^4.19.0",
    "@vue/babel-helper-vue-jsx-merge-props": "^1.4.0",
    "babel-plugin-component": "^1.1.1",
    "commitizen": "^4.2.3",
    "eslint": "^7.22.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-vue": "^7.8.0",
    "husky": "^8.0.3",
    "less": "^4.1.0",
    "lint-staged": "^13.0.3",
    "mockjs": "^1.1.0",
    "postcss-html": "^1.5.0",
    "postcss-less": "^6.0.0",
    "prettier": "^2.6.0",
    "sass": "^1.57.1",
    "stylelint": "14.16.1",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-standard": "29.0.0",
    "stylelint-config-standard-vue": "1.0.0",
    "stylelint-less": "1.0.5",
    "stylelint-prettier": "2.0.0",
    "vite": "^2.7.10",
    "vite-plugin-mock": "^2.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-theme": "^0.8.1",
    "vite-plugin-vue2": "^2.0.1",
    "vite-plugin-vue2-svg": "~0.3.0",
    "vue-template-compiler": "~2.6.14"
  },
  "resolutions": {
    "**/stylelint-config-standard": "29.0.0",
    "**/stylelint-config-recommended": "9.0.0",
    "**/stylelint-config-recommended-vue": "1.4.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,vue}": [
      "yarn lint"
    ],
    "*.{html,vue,less}": [
      "yarn css"
    ]
  }
}
